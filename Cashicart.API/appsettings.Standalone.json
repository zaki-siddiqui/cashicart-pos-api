{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=cashicart.db;",
    "SqlServerConnection": "Server=.\\SQLEXPRESS;Database=CashicartDB;Integrated Security=true;TrustServerCertificate=true;"
  },
  "DatabaseProvider": "SQLite", // Options: SQLite, SqlServer
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "File": {
      "Path": "logs/cashicart-.log",
      "RetainedFileCountLimit": 30,
      "FileSizeLimitBytes": 10485760
    }
  },
  "Jwt": {
    "Issuer": "Cashicart POS System",
    "Audience": "Cashicart Users",
    "Key": "CashicartPOS2024SecretKeyForStandaloneSystem!@#$%",
    "ExpiryMinutes": 480
  },
  "StandaloneSettings": {
    "IsStandaloneMode": true,
    "AllowRegistration": true,
    "RequireEmailConfirmation": false,
    "MaxUsers": 10,
    "LicenseValidationUrl": "https://license.cashicart.com/validate",
    "UpdateCheckUrl": "https://updates.cashicart.com/check"
  },
  "Receipt": {
    "PrinterName": "", // Leave empty for default printer
    "AutoPrint": true,
    "EmailReceipts": false,
    "ReceiptWidth": 80, // Characters
    "Logo": "wwwroot/images/logo.png"
  },
  "Backup": {
    "AutoBackup": true,
    "BackupInterval": "Daily", // Daily, Weekly, Monthly
    "BackupPath": "backups/",
    "RetentionDays": 30,
    "CloudBackup": {
      "Enabled": false,
      "Provider": "", // AWS, Azure, Google
      "ConnectionString": ""
    }
  },
  "Hardware": {
    "BarcodeScanner": {
      "Enabled": true,
      "Port": "COM1"
    },
    "CashDrawer": {
      "Enabled": false,
      "OpenCommand": "\\x1B\\x70\\x00\\x19\\xFA"
    },
    "CustomerDisplay": {
      "Enabled": false,
      "Port": "COM2"
    }
  },
  "Tax": {
    "DefaultRate": 0.0875,
    "TaxIncludedInPrice": false,
    "TaxCalculationMethod": "LineLevel" // LineLevel, OrderLevel
  },
  "Features": {
    "MultiLocation": false,
    "AdvancedReporting": true,
    "InventoryTracking": true,
    "CustomerManagement": true,
    "EmployeeTimeTracking": false,
    "LoyaltyProgram": false
  },
  "Security": {
    "RequirePasswordChange": false,
    "PasswordMinLength": 6,
    "LockoutEnabled": true,
    "MaxFailedAccessAttempts": 5,
    "LockoutTimeSpan": "00:15:00"
  },
  "AllowedHosts": "*"
}